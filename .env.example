# Demo request email (src/app/api/demo-request/route.ts). Copy to .env.local for
# local work; set the same three in the hosting provider for production.

# From https://resend.com/api-keys. Never commit the real key.
RESEND_API_KEY=

# Who receives demo requests. Comma-separated for more than one.
# Testing inbox for now; change to hello@teafactorydigital.lk once that mailbox exists.
DEMO_REQUEST_TO=rsvinnovations@gmail.com

# The sender. Keep onboarding@resend.dev until teafactorydigital.lk is verified in Resend,
# then use e.g. Tea Factory Digital <noreply@teafactorydigital.lk>.
DEMO_REQUEST_FROM=Tea Factory Digital <onboarding@resend.dev>
